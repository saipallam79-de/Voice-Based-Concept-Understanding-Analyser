GEMINI_API_KEY=
WHISPER_MODEL=base
VBCUA_SEMANTIC_MODEL=sentence-transformers/all-MiniLM-L6-v2
VBCUA_MAX_UPLOAD_MB=25
VBCUA_MAX_AUDIO_SECONDS=600
# Keep these weights non-negative and summing to 1.0.
VBCUA_UNDERSTANDING_WEIGHT=0.60
VBCUA_FLUENCY_WEIGHT=0.25
VBCUA_COMMUNICATION_WEIGHT=0.15
VBCUA_SEMANTIC_STRONG=0.70
VBCUA_SEMANTIC_MODERATE=0.50
VBCUA_COVERAGE_THRESHOLD=0.48
VBCUA_WEAK_COVERAGE_THRESHOLD=0.34
# Optional absolute path for the local SQLite database.
# VBCUA_DATABASE_PATH=